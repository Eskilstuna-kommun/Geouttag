{
  "name": "geouttag_plugin",
  "version": "1.0.0",
  "description": "",
  "main": "geouttag.js",
  "scripts": {
    "start": "npm-run-all --parallel watch-js watch-sass",
    "watch-js": "vite build --watch --mode development ",
    "prewatch-sass": "copyfiles -u 2 resources/svg/material-icons.svg ../origo/plugins/geouttag",
    "watch-sass": "sass -w scss/geouttag.scss ../origo/plugins/geouttag/geouttag.css",
    "build": "vite build --mode production && npm run build-sass && copyfiles -u 2 resources/svg/material-icons.svg build",
    "build-sass": "sass --no-source-map scss/geouttag.scss build/geouttag.css"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "globals": "^17.11.0",
    "npm-run-all2": "^8.0.4",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "sass-embedded": "1.102.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  }
}
